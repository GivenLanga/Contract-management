# API base URL override — set this if the auto-detection is not enough.
#
# Browser dev (default — Vite proxies /api → localhost:5000, no config needed):
# VITE_API_BASE_URL=/api
#
# Electron desktop dev/prod (auto-detected when window.contractiq is present):
# VITE_API_BASE_URL=http://127.0.0.1:5000/api
#
# Remote/staging deployment:
# VITE_API_BASE_URL=https://api.contractiq.example.com/api

# VITE_API_BASE_URL=
