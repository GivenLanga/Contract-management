# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# MongoDB — update with your connection string
MONGODB_URI=mongodb://localhost:27017/clm_db

# JWT — change this secret in production!
JWT_SECRET=clm-super-secret-jwt-key-2024-change-me
JWT_EXPIRES_IN=7d

# Email SMTP — configure with your SMTP provider
# For development, leave as-is to use console mock mode
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="ContractIQ <your-email@gmail.com>"

# File Storage
UPLOAD_DIR=uploads
LEGAL_FOLDER_DIR=legal-folder
TEMPLATES_DIR=templates
MAX_FILE_SIZE=52428800

# AI — Model Provider
# Set ACTIVE_MODEL_PROVIDER to: local | ollama | huggingface | hf | mock
# local = app-managed local model download + local runtime
# mock  = deterministic dev-only responses; never enable in production
ACTIVE_MODEL_PROVIDER=local
ACTIVE_MODEL_ID=qwen2.5-7b-instruct-q4
LOCAL_MODEL_RUNTIME=llama_cpp
MODEL_STORAGE_DIR=auto
ACTIVE_MODEL_AUTO_DOWNLOAD=false
ALLOW_MOCK_PROVIDER=true
ACTIVE_MODEL_NAME=qwen2.5:7b-instruct
ACTIVE_MODEL_BASE_URL=http://localhost:11434
ACTIVE_MODEL_SUPPORTS_TOOLS=false
ACTIVE_MODEL_SUPPORTS_JSON_SCHEMA=false
ACTIVE_MODEL_CONTEXT_WINDOW=32768
ACTIVE_MODEL_TEMPERATURE=0
AI_FALLBACK_MAX_TOKENS=512
AI_RAG_MAX_TOKENS=512
AI_FALLBACK_TEMPERATURE=0
AI_TOOL_TIMEOUT_MS=15000
AI_MEMORY_MAX_MESSAGES=6
AI_MEMORY_MAX_MESSAGE_CHARS=400
LOCAL_AI_CONTEXT_TOKENS=8192
LOCAL_AI_MAX_OUTPUT_TOKENS=512
LOCAL_AI_BATCH_SIZE=512
LOCAL_AI_THREADS=0
LOCAL_AI_TEMPERATURE=0

# Hugging Face — add your API key to use the hf provider
# Get free key at: https://huggingface.co/settings/tokens
HF_API_KEY=hf_your_key_here
HF_MODEL=Qwen/Qwen2.5-7B-Instruct

# Document Encryption
ENCRYPTION_KEY=clm-encryption-key-32chars-change
