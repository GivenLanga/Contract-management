# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# MongoDB — update with your connection string
MONGODB_URI=mongodb://localhost:27017/clm_db

# JWT — change this secret in production!
JWT_SECRET=clm-super-secret-jwt-key-2024-change-me
JWT_EXPIRES_IN=7d

# Email SMTP — configure with your SMTP provider
# For development, leave as-is to use console mock mode
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="ContractIQ <your-email@gmail.com>"

# File Storage
UPLOAD_DIR=uploads
LEGAL_FOLDER_DIR=legal-folder
TEMPLATES_DIR=templates
MAX_FILE_SIZE=52428800

# AI (Hugging Face) — add your API key to enable AI features
# Get free key at: https://huggingface.co/settings/tokens
HF_API_KEY=hf_your_key_here
HF_MODEL=Qwen/Qwen2.5-7B-Instruct

# Document Encryption
ENCRYPTION_KEY=clm-encryption-key-32chars-change
