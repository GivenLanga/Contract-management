# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# MongoDB
MONGODB_URI=mongodb://localhost:27017/clm_db

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="ContractIQ <your-email@gmail.com>"

# File Storage
UPLOAD_DIR=uploads
LEGAL_FOLDER_DIR=legal-folder
TEMPLATES_DIR=templates
MAX_FILE_SIZE=52428800

# AI — Local model runtime
ACTIVE_MODEL_PROVIDER=local
ACTIVE_MODEL_ID=qwen2.5-1.5b-instruct-q4
LOCAL_MODEL_RUNTIME=llama_cpp
MODEL_STORAGE_DIR=auto
ACTIVE_MODEL_AUTO_DOWNLOAD=false
ALLOW_MOCK_PROVIDER=true
ACTIVE_MODEL_NAME=qwen2.5:1.5b-instruct
ACTIVE_MODEL_BASE_URL=http://localhost:11434
ACTIVE_MODEL_SUPPORTS_TOOLS=false
ACTIVE_MODEL_SUPPORTS_JSON_SCHEMA=false
ACTIVE_MODEL_CONTEXT_WINDOW=32768
ACTIVE_MODEL_TEMPERATURE=0
ALLOW_CLOUD_AI=false
AI_FALLBACK_MAX_TOKENS=192
AI_RAG_MAX_TOKENS=320
AI_FALLBACK_TEMPERATURE=0
AI_TOOL_TIMEOUT_MS=12000
AI_MAX_MESSAGE_CHARS=2000
AI_MAX_ASSISTANT_MESSAGE_CHARS=4000
AI_CHAT_RATE_LIMIT_WINDOW_MS=600000
AI_CHAT_RATE_LIMIT_MAX=40
AI_MUTATION_RATE_LIMIT_WINDOW_MS=900000
AI_MUTATION_RATE_LIMIT_MAX=20
AI_MEMORY_MAX_MESSAGES=8
AI_MEMORY_MAX_MESSAGE_CHARS=1200
AI_MEMORY_MAX_SESSIONS=500
AI_RAG_MAX_SYNC_DOCUMENTS=500
AI_RAG_MAX_SYNC_TEXT_CHARS=60000
AI_RAG_MAX_SYNC_TOTAL_CHARS=3000000
AI_RAG_MAX_CONTEXT_SNIPPETS=6
AI_REDACT_RAG_PII=true
AI_BACKEND_RAG_ENABLED=true
AI_BACKEND_RAG_INCLUDE_SOURCE=true
AI_BACKEND_RAG_MAX_FILE_BYTES=160000
AI_BACKEND_RAG_CHUNK_CHARS=1800
AI_BACKEND_RAG_MAX_CONTEXT_SNIPPETS=8
AI_BACKEND_RAG_REINDEX_INTERVAL_MS=60000
LOCAL_AI_CONTEXT_TOKENS=3072
LOCAL_AI_MAX_OUTPUT_TOKENS=192
LOCAL_AI_BATCH_SIZE=512
LOCAL_AI_THREADS=0
LOCAL_AI_TEMPERATURE=0
ALLOW_UNVERIFIED_MODELS=false
ALLOW_INSECURE_MODEL_DOWNLOADS=false

# AI (Hugging Face, optional cloud provider)
HF_API_KEY=hf_your_hugging_face_api_key
HF_MODEL=Qwen/Qwen2.5-7B-Instruct

# Intelligent Document Processing / field detection
IDP_VISION_ENABLED=false
IDP_YOLO_MODEL_PATH=/absolute/path/to/field-detector.pt
IDP_VISION_DPI=300
IDP_VISION_CONFIDENCE=0.25
IDP_VISION_NMS_IOU=0.45
IDP_VISION_MAX_PAGES=0
IDP_PYTHON_BIN=python3
IDP_VISION_WORKER=
# Optional JSON map from model class names to app field types.
# Example: {"signature_line":"signature","date_label":"date","checkbox":"checkbox"}
IDP_VISION_LABEL_MAP={}
AWS_TEXTRACT_ENABLED=false
LAYOUTLMV3_ENDPOINT=
IDP_DISABLE_PYTHON_FALLBACK=false
LIBREOFFICE_BIN=libreoffice

# Security
ENCRYPTION_KEY=32-char-encryption-key-here-change
