# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# MongoDB
MONGODB_URI=mongodb://localhost:27017/clm_db

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="ContractIQ <your-email@gmail.com>"

# File Storage
UPLOAD_DIR=uploads
LEGAL_FOLDER_DIR=legal-folder
TEMPLATES_DIR=templates
MAX_FILE_SIZE=52428800

# AI (Hugging Face)
HF_API_KEY=hf_your_hugging_face_api_key
HF_MODEL=Qwen/Qwen2.5-7B-Instruct

# Security
ENCRYPTION_KEY=32-char-encryption-key-here-change
